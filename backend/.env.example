# Railway auto-populates DATABASE_URL when you attach a Postgres plugin.
DATABASE_URL=postgres://user:password@host:5432/dbname

# LLM provider config. Point these at Qwen or DeepSeek's OpenAI-compatible endpoint.
# Qwen (DashScope):  https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek:          https://api.deepseek.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=deepseek-chat

JWT_SECRET=replace-with-a-long-random-string
PORT=3000

# Login code delivery. Leave unset for local dev, the code just prints to
# the server console instead of sending an email.
RESEND_API_KEY=
LOGIN_EMAIL_FROM=MHC <login@example.com>

# Comma-separated list of origins allowed to call this API (your Vercel URL)
CORS_ORIGIN=http://localhost:3001
